{
  "manifest_version": 3,
  "name": "Nailong \u2014 local typo companion",
  "version": "0.3.0",
  "description": "Connect focused website editors to your local Nailong desktop pet. No cloud service.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "docs.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "incognito": "not_allowed"
}